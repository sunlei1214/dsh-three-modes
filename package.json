{
  "name": "dsh-three-modes",
  "version": "0.2.0",
  "type": "module",
  "description": "Three switchable per-session modes for DeepSeek Harness: discussion, adversarial review, and task execution",
  "author": {
    "name": "sunlei1214",
    "url": "https://github.com/sunlei1214"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunlei1214/dsh-three-modes.git"
  },
  "bugs": {
    "url": "https://github.com/sunlei1214/dsh-three-modes/issues"
  },
  "homepage": "https://github.com/sunlei1214/dsh-three-modes",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mode-switch",
    "prompt-engineering",
    "red-team"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.cjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
